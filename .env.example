# Native tools. Leave as command names if they are available in PATH.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
PIPER_PATH=piper

# Optional local AI services
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
COMFYUI_BASE_URL=http://127.0.0.1:8188
# Exact installed checkpoint name, including subfolder if any. No model is downloaded automatically.
COMFYUI_CHECKPOINT=
# Repos default to ../ComfyUI and ../VieNeu-TTS; optional overrides:
# COMFYUI_REPO=D:/vibe-code-movie/ComfyUI
# VIENEU_REPO=D:/vibe-code-movie/VieNeu-TTS
# COMFYUI_PYTHON=D:/vibe-code-movie/ComfyUI/.venv/Scripts/python.exe
# COMFYUI_CPU=true
# COMFYUI_WORKFLOW=workflows/comfyui-text-to-image.json
# COMFYUI_OUTPUT_NODE=9

# Free local Vietnamese speech server (VieNeu open-source v3 Turbo).
VIENEU_BASE_URL=http://127.0.0.1:8000
VIENEU_MODEL=vieneu-v3-turbo
VIENEU_VOICE=Hải Đăng
# VIENEU_API_KEY=only-if-your-local-server-requires-it

# Feature flags
ENABLE_OLLAMA=true
ENABLE_COMFYUI=false
ENABLE_LOCAL_TTS=false
